# Copy this file to `.env` and fill in the key for your provider. `.env` is gitignored.
#
#   cp .env.example .env
#
# The runners read the variable their provider needs (NAME=value lines below)
# from .env automatically. You can also export it in your shell, or store it in
# ~/.config/monkeydo/keys/<NAME> — outside the repository, mode 600. When no key
# is found, the runner prints the exact two-line command that creates that file.
#
# Local models through Ollama need no key at all.

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Only needed for the matching provider.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
