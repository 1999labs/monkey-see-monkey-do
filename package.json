{
  "name": "monkey-see-monkey-do",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Two automated model evals probing induction and deduction.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "self-test": "node src/self-test.mjs",
    "self-test:full": "node src/self-test.mjs --full",
    "prompts": "node bin/show-prompts.mjs",
    "see": "node src/see/run.mjs",
    "do": "node src/do/run.mjs",
    "dry-run": "node src/do/run.mjs --dry-run",
    "all": "node src/run-all.mjs",
    "gen-pool": "node bin/gen-pool.mjs",
    "check-pool": "node bin/gen-pool.mjs --check",
    "acceptance": "node bin/acceptance.mjs",
    "providers": "node bin/providers.mjs",
    "diagnose": "node bin/diagnose.mjs"
  }
}
